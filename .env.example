# Backend / AI (OpenAI-compatible variables; defaults point to Zhipu's compatible endpoint)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4-flash
OPENAI_FALLBACK_MODEL=glm-4-flash
OPENAI_TIMEOUT_MS=25000
BACKEND_PORT=8080

# Database
POSTGRES_DB=cyber_guide
POSTGRES_USER=cyber_guide
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# Email verification code. The two switches interact, and the combination
# decides what a user actually sees on the registration form:
#   ENABLED=false                  -> no code is ever required or generated.
#                                     GET /api/auth/config reports
#                                     email_code_required=false and the form
#                                     hides the code field. This is the default.
#   ENABLED=true, DEV_LOG_ONLY=true -> a real code is generated and verified,
#                                     but it only reaches the backend log. The
#                                     send API answers sent=false so the UI
#                                     never tells anyone to check an inbox that
#                                     will stay empty.
#   ENABLED=true, DEV_LOG_ONLY=false -> mail is really delivered; fill in MAIL_*
#                                     below. A blank MAIL_HOST logs an error at
#                                     startup and falls back to log-only rather
#                                     than failing every registration.
EMAIL_CODE_ENABLED=false
EMAIL_CODE_DEV_LOG_ONLY=true
EMAIL_CODE_FROM=
# EMAIL_CODE_HASH_PEPPER=change-this-in-production

# SMTP. Only needed when EMAIL_CODE_DEV_LOG_ONLY=false.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
GITHUB_FRONTEND_CALLBACK=http://localhost:3000
GITHUB_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000

# Frontend -> Backend proxy inside Docker/SSR
INTERNAL_API_BASE_URL=http://backend:8080

# Backend CORS allowlist (comma-separated origin patterns).
# Every public hostname the app is reached by must be listed, subdomains included.
# Serving the frontend from the same host does NOT exempt it: nginx and the Next.js
# rewrite both forward the browser's original Origin header, so a browser POST from
# https://guide.example.com is rejected with a bare 403 "Invalid CORS request" unless
# that exact origin appears here. The backend logs the parsed list at startup.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://*.cyberguide.dev

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Crawler
CRAWLER_ENABLED=true
CRAWLER_INTERVAL_MINUTES=360
CRAWLER_MAX_PAGES_PER_SOURCE=10
AI_EXTRACT_ENABLED=true
# 若用 bash `source .env` 注入环境变量：Cookie、逗号分隔关键词中含空格（如 CS PhD）或含 | 时，
# 请用单引号包裹整段值，否则 shell 会拆词或把 | 当管道。
ZHIHU_COOKIE=
ZHIHU_EXTRA_QUERIES=
XHS_COOKIE=
XHS_MAX_PER_QUERY=20
XHS_EXTRA_QUERIES=

# Concurrency tuning (optional)
# CHAT_MAX_INFLIGHT=90
# STREAM_MAX_INFLIGHT=20
# TOMCAT_THREADS_MAX=300
# DB_POOL_MAX=30
# REDIS_POOL_MAX_ACTIVE=48

# Chat debug log (local troubleshooting only)
# DEBUG_CHAT_LOG_ENABLED=false
# DEBUG_CHAT_LOG_MAX_CHARS=1200
# DEBUG_CHAT_LOG_ALLOWED_PROFILES=local,dev,test
# DEBUG_CHAT_LOG_SESSION_ID=
# DEBUG_CHAT_LOG_SAMPLE_RATE=1.0
